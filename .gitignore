# =====================================================
# SIT_LJGH_PROJECT — Git ignore rules
# =====================================================

# ---------- Python 编译缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 运行时临时文件 ----------
runs/
.coverage
.coverage.*
.pytest_cache/
htmlcov/
*.log
*.tmp
*.bak
*.swp

# ---------- ROS2 / 构建产物 ----------
build/
install/
log/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Agent skills (local) ----------
.reasonix/
reasonix.toml

# ---------- Generated map outputs (user-specific) ----------
map_pipeline/data/output/maps/

# =====================================================
# 说明:
# 模块之间使用版本化 JSON 结果和独立 runs/<run-id>/ 运行批次传递数据。
# 已删除的旧 path_planner/data/ 输入、输出文件不再作为必要数据维护。
# 配置文件保持跟踪:
#   - config.yaml
# =====================================================
